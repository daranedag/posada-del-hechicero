# Neon: conexión agrupada para la aplicación y directa para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Secreto aleatorio de al menos 32 caracteres. Solo servidor.
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/posada.delhechicero/
# Token de la cuenta profesional de la Posada. Solo en servidor, nunca NEXT_PUBLIC_.
IG_TOKEN=
PDH_ADMIN_EMAILS=admin@example.com,otro-admin@example.com

# ImageKit: claves de Developer options > API keys (privada solo en servidor).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# URL endpoint de tu cuenta, por ejemplo https://ik.imagekit.io/tu_imagekit_id
IMAGEKIT_URL_ENDPOINT=
# Carpeta para las nuevas subidas; la biblioteca permite reutilizar imágenes de toda la cuenta.
IMAGEKIT_UPLOAD_FOLDER=/posada-del-hechicero
